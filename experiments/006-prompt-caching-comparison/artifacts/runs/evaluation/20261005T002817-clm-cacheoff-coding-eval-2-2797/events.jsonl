{"seq": 43, "ts": "2026-10-05T00:29:01.962+00:00", "event": "execution_result", "step": 9, "exit_code": 0, "timed_out": false, "duration_s": 1.219, "stdout": "from decimal import Decimal, ROUND_HALF_UP\nQ=Decimal(\"0.01\")\ndef r(x): return x.quantize(Q,rounding=ROUND_HALF_UP)\nRATES={\"platinum\":Decimal(\"0.10\"),\"gold\":Decimal(\"0.07\"),\"silver\":Decimal(\"0.03\")}\ndef compute_invoice(lines, customer):\n    if not lines: raise ValueError(\"empty\")\n    sub=Decimal(0)\n    for l in lines:\n        q=l.get(\"qty\")\n        if not isinstance(q,int) or isinstance(q,bool) or q<0: raise ValueError(\"qty\")\n        p=Decimal(str(l[\"unit_price\"]))\n        if p<0: raise ValueError(\"price\")\n        if q==0: continue\n        a=q*p\n        if q>=100: a=a*Decimal(\"0.90\")\n        sub+=r(a)\n    d=r(sub*RATES.get(customer.get(\"tier\"),Decimal(0)))\n    t=r((sub-d)*Decimal(\"0.10\"))\n    return {\"subtotal\":str(r(sub)),\"discount\":str(d),\"tax\":str(t),\"total\":str(r(sub-d+t))}\nPFX={\"NZD\":\"NZ$\",\"AUD\":\"A$\",\"USD\":\"US$\"}\ndef format_money(amount, currency):\n    if currency not in PFX: raise ValueError(\"currency\")\n    a=r(Decimal(str(amount)))\n    return (\"-\" if a<0 else \"\")+PFX[currency]+str(abs(a))\n\n", "stderr": "", "stdout_bytes": 1011, "stderr_bytes": 0, "error": null, "runtime_trace": {"opened": [["/task/workspace/invoice/core.py", "r"]], "compiled": [], "spawned": [], "calls": {}, "context_writes": [], "imported": [], "monitoring": true}}
