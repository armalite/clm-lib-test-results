-   "body": "exit_code=0 duration=1.5s\n--- stdout ---\n\"\"\"Invoice core.\"\"\"\nfrom decimal import Decimal, ROUND_HALF_UP\n\nQ = Decimal('0.01')\n\n\ndef r2(x):\n    return Decimal(x).quantize(Q, rounding=ROUND_HALF_UP)\n\n\ndef discount_rate(lines, customer, subtotal):\n    return Decimal('0')\n\n\ndef tax_rate(customer):\n    return Decimal('0.10')\n\n\ndef line_amount(line):\n    q = int(line['qty'])\n    amt = Decimal(q) * Decimal(str(line['unit_price']))\n    if q >= 200:\n        amt = amt * Decimal('0.88')\n    elif q >= 50:\n        amt = amt * Decimal('0.95')\n    return r2(amt)\n\n\ndef validate(lines):\n    if not lines:\n        raise ValueError('empty lines')\n    for l in lines:\n        q = l.get('qty')\n        if isinstance(q, bool) or not isinstance(q, int) or q <= 0:\n            raise ValueError('bad qty')\n        try:\n            up = Decimal(str(l['unit_price']))\n        except Exception:\n            raise ValueError('bad price')\n        if not up.is_finite() or up < 0:\n            raise ValueError('negative price')\n\n\ndef compute_invoice(lines, customer):\n    validate(lines)\n    subtotal = sum((line_amount(l) for l in lines), Decimal('0.00'))\n    discount = r2(subtotal * discount_rate(lines, customer, subtotal))\n    tax = r2((subtotal - discount) * tax_rate(customer))\n    total = subtotal - discount + tax\n    return {k: str(r2(v)) for k, v in (('subtotal', subtotal), ('discount', discount), ('tax', tax), ('total', total))}\n\n\ndef format_money(amount, currency):\n    raise NotImplementedError\n\n\"\"\"Visible tests for the requirements in force after stage 3.\n\nRun from /task/workspace:  python -m unittest discover -s /task/fixtures/current-tests\n\"\"\"\n\nimport unittest\n\nimport invoice\n\n\nclass TestInvoice(unittest.TestCase):\n    maxDiff = None\n\n    def test_round_1(self):\n        self.assertEqual(invoice.compute_invoice(*[[{'sku': 'SKU-332', 'qty': 7, 'unit_price': '5.435'}, {'sku': 'SKU-117', 'qty': 7, 'unit_price': '20.123'}, {'sku': 'SKU-764', 'qty': 1, 'unit_price': '24.355'}], {'tier': 'standard', 'region': 'AU'}]), {'subtotal': '203.26', 'discount': '0.00', 'tax': '20.33', 'total': '223.59'})\n\n    def test_round_2(self):\n        self.assertEqual(invoice.compute_invoice(*[[{'sku': 'SKU-921', 'qty': 2, 'unit_price': '3.253'}, {'sku': 'SKU-595', 'qty': 4, 'unit_price': '7.837'}, {'sku': 'SKU-707', 'qty': 1, 'unit_price': '29.693'}], {'tier': 'standard', 'region': 'NZ'}]), {'subtotal': '67.55', 'discount': '0.00', 'tax': '6.75', 'total': '74.30'})\n\n    def test_tax_3(self):\n        self.assertEqual(invoice.compute_invoice(*[[{'sku': 'SKU-770', 'qty': 1, 'unit_price': '26.49'}, {'sku': 'SKU-413', 'qty': 8, 'unit_price': '23.72'}], {'tier': 'standard', 'region': 'NZ'}]), {'subtotal': '216.25', 'discount': '0.00', 'tax': '21.62', 'total': '237.87'})\n\n    def test_tax_4(self):\n        self.assertEqual(invoice.compute_invoice(*[[{'sku': 'SKU-267', 'qty': 5, 'unit_price': '86.69'}, {'sku': 'SKU-345', 'qty': 3, 'unit_price': '3.35'}], {'tier': 'standard', 'region': 'JP'}]), {'subtotal': '443.50', 'discount': '0.00', 'tax': '44.35', 'total': '487.85'})\n\n    def test_tier_5(self):\n        self.assertEqual(invoice.compute_invoice(*[[{'sku': 'SKU-847', 'qty': 2, 'unit_price': '26.24'}, {'sku': 'SKU-149', 'qty': 4, 'unit_price': '40.30'}], {'tier': 'gold', 'region': 'US'}]), {'subtotal': '213.68', 'discount': '10.68', 'tax': '20.30', 'total': '223.30'})\n\n    def test_tier_6(self):\n        self.assertEqual(invoice.compute_invoice(*[[{'sku': 'SKU-679', 'qty': 8, 'unit_price': '19.09'}, {'sku': 'SKU-596', 'qty': 3, 'unit_price': '67.46'}], {'tier': 'gold', 'region': 'US'}]), {'subtotal': '355.10', 'discount': '17.76', 'tax': '33.73', 'total': '371.07'})\n\n    def test_bulk_7(self):\n        self.assertEqual(invoice.compute_invoice(*[[{'sku': 'SKU-269', 'qty': 60, 'unit_price': '8.70'}, {'sku': 'SKU-486', 'qty': 5, 'unit_price': '15.25'}], {'tier': 'standard', 'region': 