new file mode 100644
index 0000000..f3b4b2a
--- /dev/null
+++ b/configs/exp006.toml
@@ -0,0 +1,58 @@
+# Experiment 006 configuration (prompt-caching comparison on the experiment-004 coding task):
+# experiment 004's settings (token-tail/1 baseline, 8K whole-request budget, same model/effort,
+# max_calls 30, max_output_tokens 4096) plus request layout blocks/1, explicit 5-minute cache
+# breakpoints when a run has caching on, and a random per-run tag (run-tag/1) in every
+# condition. Caching on/off is set per run by `compare --conditions` (or `run --caching`); the
+# config default is off. The ledger ceiling is the one authorised for this experiment (spend at
+# start USD 19.932944 + USD 30). Use only this config for experiment-006 live commands.
+# All limits are recorded in every run and shared by all four conditions.
+runs_dir = "runs"
+
+[provider]
+name = "anthropic"
+model = "claude-opus-5-5"     # verified via the models endpoint by `clm-lib doctor --probe`
+base_url = ""                 # empty: SDK default (or ANTHROPIC_BASE_URL)
+effort = "low"                # output_config.effort; thinking cannot be disabled on this model
+structured_output = true      # output_config.format json_schema for actions
+timeout_s = 120
+api_retries = 2               # runtime-level retries; SDK retries are disabled
+
+[limits]
+max_calls = 30                # per task: actions + repairs + summaries + API retries
+max_output_tokens = 4096
+exec_timeout_s = 30
+output_cap_chars = 6000       # per stream
+context_budget_tokens = 8000  # whole request input
+pressure_ratio = 0.70
+recovery_reserve_tokens = 1000
+spill_min_chars = 1500
+initial_chars_per_token = 3.0
+max_code_chars = 20000
+
+[baseline]
+policy = "token-tail/1"     # experiment 003; experiments 001/002 used "fixed-tail/1"
+tail_entries = 4
+summary_max_chars = 3000
+summary_retries = 1
+tail_ratio = 0.15            # token-tail/1: verbatim recent-entry allowance (fraction of budget)
+newest_ratio = 0.25          # token-tail/1: newest entry kept verbatim if it fits this fraction
+target_ratio = 0.50          # token-tail/1: desired request size after compaction
