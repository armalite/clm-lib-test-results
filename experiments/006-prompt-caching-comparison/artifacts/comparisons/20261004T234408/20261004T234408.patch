+    bad.write_text("[request]\nprompt_caching = true\n")
+    with pytest.raises(ValueError, match="blocks/1"):
+        load_config(bad)
+    bad.write_text('[request]\nlayout = "blocks/2"\n')
+    with pytest.raises(ValueError, match="layout"):
