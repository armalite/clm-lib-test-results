+def _stdout(res: Any, step: int) -> str:
+    for line in (res.run_dir / "events.jsonl").read_text().splitlines():
+        e = json.loads(line)
+        if e["event"] == "execution_result" and e["step"] == step:
+            return e["stdout"]
+    raise AssertionError("no execution")
