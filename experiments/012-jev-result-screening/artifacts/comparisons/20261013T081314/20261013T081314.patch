+def _doc(doc: str, title: str, meta: str, sections: list[tuple[str, str]]) -> str:
+    lines = [f"# {doc} · {title}", meta, ""]
+    for i, (h, t) in enumerate(sections, start=1):
+        lines += [f"§{i} {h}", t, ""]
+    return "\n".join(lines)
