+   "body": "exit_code=0 duration=1.1s\n--- stdout ---\nimport json\nimport csv, io\n\ndef export_records(records, user, params):\n    params = params or {}\n    role = user.get('role')\n    if role == 'viewer':\n        raise PermissionError('viewer')\n    out = []\n    since = params.get('since')\n    for r in records:\n        if role != 'admin' and r.get('project') not in user.get('projects', []) and r.get('owner') != user.get('name'):\n            continue\n        st = r.get('status')\n        if not (st == 'active' or (st == 'archived' and params.get('include_archived') is True)):\n            continue\n        if r.get('confidential') is True and not (role == 'admin' and params.get('purpose') == 'audit'):\n            continue\n        if since is not None and str(r.get('created', ''))[:10] < since:\n            continue\n        if r.get('region') == 'eu' and 'eu' not in (user.get('regions') or []):\n            continue\n        out.append(r)\n    out.sort(key=lambda r: r['id'])\n    mx = params.get('max_records')\n    if isinstance(mx, int) and mx >= 1:\n        out = out[:mx]\n    recs = []\n    for r in out:\n        t = r['title']\n        recs.append({'id': int(r['id']), 'title': t.strip() if isinstance(t, str) else t, 'owner': r['owner'], 'amount': r['amount']})\n    doc = {'records': recs, 'exported_by': user.get('name')}\n    return json.dumps(doc)\n\n"
