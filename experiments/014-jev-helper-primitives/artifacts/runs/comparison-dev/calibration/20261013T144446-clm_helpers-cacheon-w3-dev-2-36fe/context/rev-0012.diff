+   "body": "exit_code=0 duration=0.9s\n--- stdout ---\nimport json\n\n\ndef export_records(records, user, params):\n    params = params or {}\n    role = user.get(\"role\")\n    if role == \"viewer\":\n        raise PermissionError(\"viewer\")\n    out = []\n    for r in sorted(records, key=lambda r: r[\"id\"]):\n        if role != \"admin\" and r.get(\"project\") not in user.get(\"projects\", []):\n            continue\n        st = r.get(\"status\")\n        if not (st == \"active\" or (st == \"archived\" and params.get(\"include_archived\") is True)):\n            continue\n        since = params.get(\"since\")\n        if since is not None and (r.get(\"updated\") or r[\"created\"]) < since:\n            continue\n        if r.get(\"confidential\") is True and not (role == \"admin\" and params.get(\"purpose\") == \"audit\"):\n            continue\n        if r.get(\"region\") == \"eu\" and \"eu\" not in (user.get(\"regions\") or []):\n            continue\n        out.append(r)\n    mx = params.get(\"max_records\")\n    if isinstance(mx, int) and mx >= 1:\n        out = out[:mx]\n    recs = [{\"id\": r[\"id\"], \"title\": r[\"title\"].strip(), \"owner\": r[\"owner\"], \"amount\": r[\"amount\"]} for r in out]\n    return json.dumps({\"exported_by\": user.get(\"name\"), \"records\": recs})\n\n"
