+   "body": "exit_code=0 duration=0.9s\n--- stdout ---\nimport json\n\ndef export_records(records, user, params):\n    params = params or {}\n    role = user.get('role')\n    if role == 'viewer':\n        raise PermissionError('viewer may not export')\n    since = params.get('since')\n    regions = [str(x).lower() for x in (user.get('regions') or [])]\n    out = []\n    for r in records:\n        if role != 'admin' and r.get('project') not in (user.get('projects') or []) and r.get('owner') != user.get('name'):\n            continue\n        st = r.get('status')\n        if not (st == 'active' or (st == 'archived' and params.get('include_archived') is True and role == 'admin')):\n            continue\n        if r.get('confidential') is True and not (role == 'admin' and params.get('purpose') == 'audit'):\n            continue\n        if since is not None and str(r.get('created', ''))[:10] < since:\n            continue\n        if str(r.get('region') or '').lower() == 'ch' and 'ch' not in regions:\n            continue\n        out.append(r)\n    out.sort(key=lambda r: r['id'])\n    mx = params.get('max_records')\n    if isinstance(mx, int) and not isinstance(mx, bool) and mx >= 1:\n        out = out[:mx]\n    recs = []\n    for r in out:\n        t = r['title']\n        recs.append({'id': r['id'], 'title': ' '.join(t.split()) if isinstance(t, str) else t, 'owner': r['owner'], 'amount': r['amount']})\n    return json.dumps({'exported_by': user.get('name'), 'records': recs})\n\n"
