+   "body": "exit_code=0 duration=1.8s\n--- stdout ---\nimport json\nimport csv, io\n\ndef export_records(records, user, params):\n    params = params or {}\n    role = user.get('role')\n    if role == 'viewer':\n        raise PermissionError('viewer')\n    out = []\n    for r in sorted(records, key=lambda r: r['id']):\n        if role != 'admin' and r['project'] not in user.get('projects', []):\n            continue\n        if r['status'] != 'active' and not (r['status'] == 'archived' and params.get('include_archived') is True):\n            continue\n        if r.get('confidential') is True and not (role == 'admin' and params.get('purpose') == 'audit'):\n            continue\n        if params.get('since') is not None and str(r.get('created',''))[:10] < params['since']:\n            continue\n        out.append(r)\n    return json.dumps({'records': [{'id': int(r['id']), 'title': r['title'], 'owner': r['owner'], 'amount': str(r['amount'])} for r in out], 'exported_by': user.get('name')})\n\nimport json, clm_jev\nP='/task/workspace/context.json'\ndef load(): return json.load(open(P))\ndef save(c): json.dump(c, open(P,'w'))\ndef update(new_req, new_notes, drop_prefixes=('s',)):\n    \"\"\"Ask Jev whether new requirements affect each note; keep unaffected/historical, mark affected.\"\"\"\n    c = load(); ents = c['entries']\n    notes = {e['id']: e['body'] for e in ents if e['role']=='note'}\n    probs = {}\n    if notes:\n        r = clm_jev.judge('Do the new requirements change or replace the rule described in this note?', notes, background=new_req[:6000])\n        if r.get('status')=='ok': probs = r['answers']\n    keep = []\n    for e in ents:\n        if e['role']=='note':\n            p = probs.get(e['id'])\n            if 'HISTORICAL' not in e['body'] and p is not None and p > 0.5:\n                e['body'] = '[REVIEW: possibly affected by newer stage, see CHANGED rules] ' + e['body']\n            keep.append(e)\n        elif not e['id'].startswith(drop_prefixes):\n            keep.append(e)\n    for i,b in new_notes.items(): keep.append({'id':i,'role':'note','body':b})\n    c['entries'] = keep; save(c); return probs\n\n"
