   "SUMMARY.md",
   "protocol.md"
  ],
  "generated": [
   "manifest.json",
   "report.md",
   "metrics.json",
   "metrics.csv"
  ],
  "note": "human-maintained documents are owned by the results repository and never overwritten by export"
 },
 "checksum_policy": "artifacts/** trees carry their own SHA256SUMS and are immutable; the experiment SHA256SUMS covers artifacts and generated files and excludes human-maintained documents",
 "redactions": [
  {
   "file": "run.json",
   "field": "executor.user",
   "replacement": "<host uid:gid> (non-root)",
   "reason": "local account id; not needed to interpret the run"
  }
 ],
 "excluded": [
  "credential files and environment (never present in run artifacts)",
  "request headers (never recorded)",
  "per-run fixtures/ copies (exported once per task under artifacts/fixtures, hash-verified)"
 ]
}
