+   "body": "exit_code=0 duration=2.1s\n--- stdout ---\nimport csv, io\n\n\ndef export_records(records, user, params):\n    params = params or {}\n    role = user.get('role')\n    if role == 'viewer':\n        raise PermissionError('viewer cannot export')\n    out = []\n    for r in sorted(records, key=lambda r: r['id']):\n        if role != 'admin' and r['project'] not in user.get('projects', []):\n            continue\n        if r['confidential'] and not (role == 'admin' and params.get('purpose') == 'audit'):\n            continue\n        if r['status'] != 'active' and not (r['status'] == 'archived' and params.get('include_archived') is True):\n            continue\n        out.append(r)\n    buf = io.StringIO()\n    w = csv.writer(buf, lineterminator='\\n')\n    w.writerow(['id', 'title', 'owner', 'amount'])\n    for r in out:\n        w.writerow([int(r['id']), r['title'], r['owner'], r['amount']])\n    return buf.getvalue()\n\n\"\"\"Visible tests for the rules introduced or changed in stage 3 only.\n\nEarlier rules still apply; they are not repeated here.\nRun from /task/workspace:  python -m unittest discover -s /task/fixtures/current-tests\n\"\"\"\n\nimport json\nimport unittest\n\nimport exporter\n\n\nclass TestStage(unittest.TestCase):\n    maxDiff = None\n\n    def test_since_1(self):\n        out = json.loads(exporter.export_records(*[[{'id': 301, 'title': 'Vendor list', 'owner': 'fay', 'project': 'apollo', 'status': 'active', 'amount': '44.92', 'confidential': False, 'created': '2026-06-07'}, {'id': 465, 'title': 'Q3 report', 'owner': 'ben', 'project': 'borealis', 'status': 'archived', 'amount': '78.39', 'confidential': False, 'created': '2026-03-15'}, {'id': 568, 'title': 'Vendor list', 'owner': 'chen', 'project': 'apollo', 'status': 'active', 'amount': '711.4', 'confidential': False, 'created': '2026-03-17'}], {'name': 'chen', 'role': 'member', 'projects': ['apollo', 'borealis']}, {'include_archived': False, 'since': '2026-06-07'}]))\n        self.assertEqual(out['records'], [{'id': 301, 'title': 'Vendor list', 'owner': 'fay', 'amount': '44.92'}])\n\n    def test_since_2(self):\n        out = json.loads(exporter.export_records(*[[{'id': 254, 'title': 'Hiring plan, v2', 'owner': 'ben', 'project': 'borealis', 'status': 'active', 'amount': '234.08', 'confidential': False, 'created': '2026-03-25'}, {'id': 706, 'title': 'The \"north\" plan', 'owner': 'ana', 'project': 'cygnus', 'status': 'archived', 'amount': '417.81', 'confidential': False, 'created': '2026-06-10'}, {'id': 401, 'title': 'Roadmap', 'owner': 'ana', 'project': 'apollo', 'status': 'active', 'amount': '517.44', 'confidential': True, 'created': '2026-02-05'}], {'name': 'fay', 'role': 'member', 'projects': ['borealis', 'cygnus']}, {'since': '2026-05-01'}]))\n        self.assertEqual(out['records'], [])\n\n    def test_format_3(self):\n        out = json.loads(exporter.export_records(*[[{'id': 395, 'title': 'Risk log', 'owner': 'chen', 'project': 'borealis', 'status': 'active', 'amount': '542.15', 'confidential': False, 'created': '2026-05-09'}, {'id': 363, 'title': 'Roadmap', 'owner': 'dara', 'project': 'borealis', 'status': 'archived', 'amount': '181.68', 'confidential': True, 'created': '2026-01-13'}, {'id': 572, 'title': 'Audit prep', 'owner': 'fay', 'project': 'borealis', 'status': 'active', 'amount': '11.34', 'confidential': False, 'created': '2026-04-13'}], {'name': 'dara', 'role': 'member', 'projects': ['delta', 'eos']}, {'purpose': 'audit', 'since': '2026-02-19'}]))\n        self.assertEqual(out['records'], [])\n\n    def test_format_4(self):\n        out = json.loads(exporter.export_records(*[[{'id': 185, 'title': 'Vendor list', 'owner': 'eli', 'project': 'borealis', 'status': 'archived', 'amount': '42', 'confidential': False, 'created': '2026-04-13'}, {'id': 231, 'title': 'Ops review', 'owner': 'chen', 'project': 'delta', 'status': 'active', 'amount': '790.7', 'confidential': False, 'created': '2026-01-03'}, {'id': 866, 'title': 'Vendor list', 'owner': 'fay', 'project': 'cygnus', 'status': 'archived', 'amount': '687.9', 'confidential': False, 'created': '2026-03-18'}, {'id': 58, 'title': 'Ops review', 'owner': 'chen', 'project': 'apollo', 'status': 'archived', 'amount': '467.73', 'confidential': False, 'created': '2026-01-19'}, {'id': 905, 'title': 'Q3 report', 'owner': 'eli', 'project': 'apollo', 'status': 'active', 'amount': '898.37', 'confidential': False, 'created': '2026-01-01'}], {'name': 'ana', 'role': 'member', 'projects': ['borealis']}, {'purpose': 'audit'}]))\n        self.assertEqual(out['records'], [])\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n\n"
