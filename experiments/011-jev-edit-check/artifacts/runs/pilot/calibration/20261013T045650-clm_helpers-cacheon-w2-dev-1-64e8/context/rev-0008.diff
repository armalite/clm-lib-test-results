+   "body": "exit_code=0 duration=1.5s\n--- stdout ---\nimport csv, io\n\n\ndef export_records(records, user, params):\n    params = params or {}\n    role = user.get('role')\n    if role == 'viewer':\n        raise PermissionError('viewer cannot export')\n    out = []\n    for r in records:\n        if role != 'admin' and r['project'] not in user.get('projects', []):\n            continue\n        if r['status'] != 'active' and not (r['status'] == 'archived' and params.get('include_archived') is True):\n            continue\n        if r.get('confidential') is True and not (role == 'admin' and params.get('purpose') == 'audit'):\n            continue\n        since = params.get('since')\n        if since is not None and str(r.get('created'))[:10] < since:\n            continue\n        out.append(r)\n    out.sort(key=lambda r: r['id'])\n    buf = io.StringIO()\n    w = csv.writer(buf, lineterminator='\\n')\n    w.writerow(['id', 'title', 'owner', 'amount'])\n    for r in out:\n        w.writerow([int(r['id']), r['title'], r['owner'], r['amount']])\n    return buf.getvalue()\n\n\"\"\"Visible tests for the rules introduced or changed in stage 3 only.\n\nEarlier rules still apply; they are not repeated here.\nRun from /task/workspace:  python -m unittest discover -s /task/fixtures/current-tests\n\"\"\"\n\nimport json\nimport unittest\n\nimport exporter\n\n\nclass TestStage(unittest.TestCase):\n    maxDiff = None\n\n    def test_format_1(self):\n        out = json.loads(exporter.export_records(*[[{'id': 902, 'title': 'The \"north\" plan', 'owner': 'dara', 'project': 'delta', 'status': 'archived', 'amount': '273.9', 'confidential': False, 'created': '2026-07-11'}, {'id': 603, 'title': 'Ops review', 'owner': 'ben', 'project': 'delta', 'status': 'active', 'amount': '65.19', 'confidential': False, 'created': '2026-01-27'}, {'id': 114, 'title': 'Ops review', 'owner': 'ana', 'project': 'cygnus', 'status': 'archived', 'amount': '508', 'confidential': False, 'created': '2026-06-10'}], {'name': 'ben', 'role': 'member', 'projects': ['cygnus']}, {}]))\n        self.assertEqual(out['records'], [])\n\n    def test_format_2(self):\n        out = json.loads(exporter.export_records(*[[{'id': 196, 'title': 'The \"north\" plan', 'owner': 'ana', 'project': 'apollo', 'status': 'active', 'amount': '37.7', 'confidential': False, 'created': '2026-07-09'}, {'id': 50, 'title': 'Risk log', 'owner': 'ana', 'project': 'cygnus', 'status': 'active', 'amount': '631.7', 'confidential': False, 'created': '2026-06-17'}, {'id': 427, 'title': 'Hiring plan, v2', 'owner': 'eli', 'project': 'delta', 'status': 'active', 'amount': '527', 'confidential': True, 'created': '2026-04-25'}, {'id': 14, 'title': 'Roadmap', 'owner': 'ben', 'project': 'eos', 'status': 'active', 'amount': '36', 'confidential': False, 'created': '2026-05-27'}, {'id': 767, 'title': 'Vendor list', 'owner': 'eli', 'project': 'borealis', 'status': 'active', 'amount': '784.9', 'confidential': False, 'created': '2026-08-13'}, {'id': 800, 'title': 'Roadmap', 'owner': 'fay', 'project': 'eos', 'status': 'archived', 'amount': '466.44', 'confidential': True, 'created': '2026-07-17'}], {'name': 'fay', 'role': 'member', 'projects': ['apollo']}, {'include_archived': True}]))\n        self.assertEqual(out['records'], [{'id': 196, 'title': 'The \"north\" plan', 'owner': 'ana', 'amount': '37.7'}])\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n\n"
