+# Experiment 011 AGENT PILOT configuration (W2 workload, conditions A/B/C). Main-model and
+# TypeSafe calls. Identical to configs/exp011v2.toml (itself carried over from exp010v3.toml)
+# except for the ceiling and the new [edit_check] section. The conditions set edit_check per run
+# (compare --conditions clm_helpers:on,clm_helpers+chk:on,clm_helpers+chk-jev:on), so
+# [edit_check] enabled/advice stay false here. Ledger ceiling: settled spend at start USD
+# 82.010420 + USD 15 authorised for the pilot (both providers, smoke, runs and retries) =
+# 97.010420 (replaces the unused 011 v2 allowance).
+runs_dir = "runs"
+
+[provider]
+name = "anthropic"
+model = "claude-opus-5-5"     # verified via the models endpoint by `clm-lib doctor --probe`
+base_url = ""                 # empty: SDK default (or ANTHROPIC_BASE_URL)
+effort = "low"                # output_config.effort; thinking cannot be disabled on this model
+structured_output = true      # output_config.format json_schema for actions
